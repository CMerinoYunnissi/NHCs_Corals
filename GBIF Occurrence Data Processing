#I define duplicate when records have the same catalogNumber, publisher & scientificName
NHCs_flagged <- NHCs %>%
  mutate(
    possible_duplicate = duplicated(paste(catalogNumber, publisher, scientificName)) |
      duplicated(paste(catalogNumber, publisher, scientificName), fromLast = TRUE)
  )
sum(NHCs_flagged$possible_duplicate) #12,770




#3. refine flagged "possible duplicates" into actual "duplicates"
NHCs_deduped <- NHCs_flagged %>%
  group_by(catalogNumber, publisher, scientificName) %>%
  mutate(
    duplicate_rank = case_when(
      # Rule 1: Keep most recent modified date
      publisher %in% c(
        "Bernice Pauahi Bishop Museum",
        "National Museum of Natural History, Smithsonian Institution"
      ) ~ rank(desc(as.Date(modified)), ties.method = "first"),
      
      # Rule 2: Keep record with more complete data
      publisher %in% c(
        "Naturalis Biodiversity Center",
        "IFREMER -  French Research Institute for Exploitation of the Sea",
        "Natural History Museum",
        "Abilene Christian University Natural History Collection",
        "Florida Museum of Natural History",
        "National Science Museum of Korea",
        "Comisión nacional para el conocimiento y uso de la biodiversidad"
      ) ~ rank(
        desc(!is.na(decimalLatitude) | !is.na(decimalLongitude) |
               !is.na(year) | !is.na(Year) |
               !is.na(individualCount) | !is.na(countryCode) |
               !is.na(locality) | !is.na(institutionCode)),
        ties.method = "first"
      ),
      
      # Rule 3: Keep record with disposition if possible
      publisher == "Instituto de Investigaciones Marinas y Costeras - Invemar" ~ rank(
        desc(!is.na(disposition)),
        ties.method = "first"
      ),
      
      # Default: keep first
      TRUE ~ 1
    ),
    is_duplicate = if_else(duplicate_rank > 1, TRUE, FALSE)
  ) %>%
  ungroup()



