#4. create function
extract_year <- function(date_string) {
  # Remove any leading or trailing whitespace
  date_string <- trimws(date_string)
  
  # Handle cases starting with "Pre" (treat as ambiguous and return NA)
  if (grepl("^Pre|approximately", date_string, ignore.case = TRUE)) {
    return(NA)  # Return NA for ambiguous "Pre" or "approximately" cases
  }
  
  # Special case handling for the three specific formats
  if (grepl("^April 1930 \\(begin\\)$", date_string, ignore.case = TRUE)) {
    return(1930)
  }
  if (grepl("^april 1930 begin$", date_string, ignore.case = TRUE)) {
    return(1930)
  }
  if (grepl("^begin April 1930$", date_string, ignore.case = TRUE)) {
    return(1930)
  }
  
  # 0. Check for "no date recorded" and return NA immediately
  if (grepl("no date recorded", date_string, ignore.case = TRUE)) {
    return(NA)
  }
  
  # 1. Handle Roman numeral dates (e.g., vii.-ix.1904)
  if (grepl("^vii\\.-ix\\.\\d{4}$", date_string)) {
    return(1904)  # Treat as a year based on the string
  }
  
  # 2. Handle "YYYY Month" format (e.g., "1974 June", "1979 April", etc.)
  if (grepl("^\\d{4}\\s+[A-Za-z]+$", date_string)) {
    return(as.numeric(substr(date_string, 1, 4)))  # Extract year from the start
  }
  
  # 3. Handle xx-yy-YYYY format (e.g., xx-yy-1961, xx-yy-1968, etc.)
  if (grepl("^\\d{2}-\\d{2}-\\d{4}$", date_string)) {
    return(as.numeric(substr(date_string, nchar(date_string) - 3, nchar(date_string))))
  }
  
  # 4. Handle month names in German (e.g., Juni 1972)
  if (grepl("juni|mai|märz|März|oktober|august|dezember|februar|märz|juli|julin", date_string)) {
    year_match <- regmatches(date_string, regexpr("\\d{4}", date_string))
    if (length(year_match) > 0) {
      return(as.numeric(year_match))
    }
  }
  
  # 5. Handle "Circa 1980" format
  if (grepl("^circa \\d{4}$", date_string)) {
    return(as.numeric(substr(date_string, 7, 10)))  # Extract the year
  }
  
  # 6. Handle "8/*/1983" format (or any other similar formats)
  if (grepl("^\\d{1,2}/\\*/\\d{4}$", date_string)) {
    return(as.numeric(substr(date_string, nchar(date_string) - 3, nchar(date_string))))
  }
  
  # 7. Handle "*/*/YYYY" format (e.g., "*/8/1962", "*/5/1978")
  if (grepl("^\\*/\\*/\\d{4}$", date_string)) {
    return(as.numeric(substr(date_string, nchar(date_string) - 3, nchar(date_string))))
  }
  
  # 8. Handle "3/17-19/1998" format (e.g., range with same year)
  if (grepl("^\\d{1,2}/\\d{2}-\\d{2}/\\d{4}$", date_string)) {
    return(as.numeric(substr(date_string, nchar(date_string) - 3, nchar(date_string))))
  }
  
  # 9. Handle date ranges where the year is the same or different (e.g., Jan 1978 - Apr 1979 or Jan 1978 to Apr 1979)
  if (grepl("([A-Za-z]+ \\d{4})\\s*(?:-|to)\\s*([A-Za-z]+ \\d{4})$", date_string)) {
    # Extract both years from the range using regular expressions
    years <- unlist(regmatches(date_string, gregexpr("\\d{4}", date_string)))
    
    # Debugging step: Print extracted years to ensure correct extraction
    print(years)
    
    # Ensure we have two years extracted
    if (length(years) == 2) {
      # If the years are different, return NA
      if (years[1] != years[2]) {
        return(NA)  # Return NA if years are different
      } else {
        return(as.numeric(years[1]))  # Return the year if both are the same
      }
    } else {
      return(NA)  # Return NA if two years are not extracted
    }
  }
  
  
  # 10. Handle "1 November 1976-31 December 1976"
  if (grepl("\\d{1,2} [A-Za-z]+ \\d{4}-\\d{1,2} [A-Za-z]+ \\d{4}", date_string)) {
    year <- year(dmy(strsplit(date_string, "-")[[1]][1]))  # Extract year from the first date in the range
    return(year)
  }
  
  # 11. Handle "xx-yy-YYYY" formats (where only the year is clear)
  if (grepl("^.{2}-.{2}-\\d{4}$", date_string)) {
    return(as.numeric(substr(date_string, nchar(date_string) - 3, nchar(date_string))))
  }
  
  # 12. Handle ambiguous 2-digit years (e.g., "16/09/84" could be 1984 or 1884)
  if (grepl("^\\d{2}/\\d{2}/\\d{2}$", date_string)) {
    return(NA)  # Return NA as it's indeterminable (could be 1984 or 1884)
  }
  
  # 13. Handle indeterminable cases like "Indeterminable {? no year June 12}"
  if (grepl("Indeterminable", date_string)) {
    return(NA)
  }
  
  # 14. Handle "03/1916" format (month-year)
  if (grepl("^\\d{2}/\\d{4}$", date_string)) {
    return(as.numeric(substr(date_string, 4, 7)))  # Extract the year
  }
  
  # 15. Handle "10 16" format (month-day, no year)
  if (grepl("^\\d{2} \\d{2}$", date_string)) {
    return(NA)  # Return NA as no year is provided
  }
  
  # 16. Handle incomplete year (e.g., "1904-07-" should return 1904)
  if (grepl("^\\d{4}-\\d{2}-?$", date_string)) {
    return(as.numeric(substr(date_string, 1, 4)))  # Extract the year
  }
  
  # 17. Handle formats like "xx-05-1920"
  if (grepl("^\\d{2}-05-\\d{4}$", date_string)) {
    return(as.numeric(substr(date_string, 7, 10)))  # Extract the year
  }
  
  # 18. Handle formats like "10 June 1922 (namiddag)" or "12 Jun 1922 (voormiddag)"
  if (grepl("^\\d{1,2} [A-Za-z]+ \\d{4}", date_string)) {
    return(as.numeric(substr(date_string, nchar(date_string)-3, nchar(date_string))))  # Extract the year
  }
  
  # 19 Handle ambiguous 2-digit years Apr-52", "Aug-28", "Jan-49"
  if (grepl("^[A-Za-z]{3}-\\d{2}$", date_string)) {
    return(NA)  # Return NA for cases like "Apr-52", "Aug-28", "Jan-49"
  }
  
  # 20. Handle formats like "Jul 1944", "Aug 1945" (Month Year format)
  if (grepl("^[A-Za-z]{3} \\d{4}$", date_string)) {
    return(as.numeric(substr(date_string, nchar(date_string)-3, nchar(date_string))))  # Extract the year
  }
  
  # 20. Handle formats like "April 1952", "May 1950" (Month Year format)
  if (grepl("^[A-Za-z]+ \\d{4}(\\s*[^A-Za-z0-9].*)?$", date_string)) {
    return(as.numeric(substr(date_string, nchar(date_string)-3, nchar(date_string))))  # Extract the year
  }
  
  # 21. Handle "-- --- 1884", "-- --- 1913", "-- --- 1914", or similar formats
  if (grepl("^-- --- \\d{4}$", date_string)) {
    return(as.numeric(substr(date_string, 8, 11)))  # Extract the year
  }
  
  # 22. Handle standard Month-Day-Year formats (e.g., "11 May 1923")
  if (!is.na(dmy(date_string))) {
    return(year(dmy(date_string)))  # DD-MM-YYYY
  } else if (!is.na(mdy(date_string))) {
    return(year(mdy(date_string)))  # MM/DD/YYYY
  } else if (!is.na(ymd(date_string))) {
    return(year(ymd(date_string)))  # YYYY-MM-DD
  } else if (grepl("^\\d{4}$", date_string)) {
    return(as.numeric(date_string))  # Only a year (e.g., 1993)
  }
  # 23. Handle "DD.MM.YYYY-DD.MM.YYYY" format (e.g., "21.07.1967-21.07.1967")
  if (grepl("^\\d{2}\\.\\d{2}\\.\\d{4}\\s*-\\s*\\d{2}\\.\\d{2}\\.\\d{4}$", date_string)) {
    # Extract and return the year (last 4 digits of the range)
    return(as.numeric(substr(date_string, nchar(date_string) - 3, nchar(date_string))))
  }
  
  # 24. Handle "YYYY-MM - YYYY-MM" format (e.g., "1987-11 - 1987-12")
  if (grepl("^\\d{4}-\\d{2}\\s*-\\s*\\d{4}-\\d{2}$", date_string)) {
    # Extract and return the year (last 4 digits of the range)
    year_match <- regmatches(date_string, regexpr("\\d{4}", date_string))
    return(as.numeric(year_match[1]))  # Extract the first matched year
  }
  #25. # Handle "MM/YYYY-MM/YYYY" format (e.g., "01/1983-04/1983")
  if (grepl("^\\d{2}/\\d{4}-\\d{2}/\\d{4}$", date_string)) {
    # Extract the years from both parts of the range (before and after the hyphen)
    years <- unlist(regmatches(date_string, gregexpr("\\d{4}", date_string)))
    
    # If we have two years extracted, return the year (you can return either year because they are the same in this format)
    if (length(years) == 2) {
      return(as.numeric(years[1]))  # Return the first year (they should be the same in this format)
    } else {
      return(NA)  # Return NA if the format is not as expected
    }
  }
  
  # If none of the above formats match, return NA
  return(NA)
}

