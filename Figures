#calculate the decline from 1939 to the average or total during 1940–1945
# 1. Get number of records in 1939
records_1939 <- nhcs_timeline %>%
  filter(Year == 1939) %>%
  nrow()

# 2. Get number of records per year from 1940 to 1945
records_1940_1945 <- nhcs_timeline %>%
  filter(Year >= 1940, Year <= 1945) %>%
  group_by(Year) %>%
  summarise(records = n())

# 3. Calculate the average and median number of records during 1940-1945
average_records_1940_1945 <- mean(records_1940_1945$records)
median_records_1940_1945 <- median(records_1940_1945$records)

# 4. Calculate the decline (%)
percent_decline <- ((records_1939 - average_records_1940_1945) / records_1939) * 100
percent_decline_median <- ((records_1939 - median_records_1940_1945) / records_1939) * 100

# 5. Print results
cat(sprintf("Records in 1939: %d\n", records_1939)) #Records in 1939: 91
cat(sprintf("Average records 1940-1945: %.1f\n", average_records_1940_1945)) #Average records 1940-1945: 63.0
cat(sprintf("Percentage decline from 1939 to 1940–1945: %.1f%%\n", percent_decline)) #Percentage decline from 1939 to 1940–1945: 30.8%

cat(sprintf("Median records 1940-1945: %.1f\n", median_records_1940_1945)) # Median records 1940-1945: 27.0
cat(sprintf("Percentage decline from 1939 to 1940–1945 (based on median): %.1f%%\n", percent_decline_median)) #Percentage decline from 1939 to 1940–1945 (based on median): 70.3%



