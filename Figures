#% of records in a specific period (e.g., 1974–1986)
# 1. Prepare data: filter years between 1820 and 2020
nhcs_timeline <- NHCs_final %>%
  filter(!is.na(Year), Year >= 1820, Year <= 2020)
# 2. Total records and total timeline length
total_records <- nrow(nhcs_timeline)
total_years <- 2020 - 1820 + 1  # Inclusive
# 3. Subset for the period 1974–1986
subset_period <- nhcs_timeline %>%
  filter(Year >= 1974, Year <= 1986)
# 4. Calculate
subset_records <- nrow(subset_period)
subset_years <- 1986 - 1974 + 1  # Inclusive
# 5. Percentages
percent_records <- (subset_records / total_records) * 100
percent_years <- (subset_years / total_years) * 100
# 6. Print results
cat("From 1974 to 1986:\n")
cat(sprintf("Records: %d (%.1f%% of all records)\n", subset_records, percent_records))
cat(sprintf("Years: %d years (%.1f%% of the full timeline)\n", subset_years, percent_years))

